enum EvolutionStage {
  UNAWARE
  EXPLORER
  BUILDER
  OPERATOR
  STRATEGIST
  CREATOR
  LEADER
  LEGACY_BUILDER
}

enum DevLayer {
  WORLDVIEW
  MISSION
  IDENTITY
  VALUES
  MENTAL_MODELS
  FIRST_PRINCIPLES
  DECISIONS
  BEHAVIOR
  HABITS
  MASTERY
  LEADERSHIP
  LEGACY
}

enum MasteryStage {
  NOVICE
  BEGINNER
  PRACTITIONER
  PROFESSIONAL
  EXPERT
  MASTER
}

enum ShadowType {
  PROCRASTINATION
  COMFORT_ADDICTION
  STATUS_ADDICTION
  CONFIRMATION_BIAS
  SUNK_COST_BIAS
  EGO
  FEAR
  AVOIDANCE
  DISTRACTION
}

enum ModelArchetype {
  EINSTEIN
  BUFFETT
  DISNEY
  JOBS
  MUNGER
  MUSK
  DALIO
  CUSTOM
}

enum ModelCategory {
  ECONOMICS
  PSYCHOLOGY
  SYSTEMS
  PROBABILITY
  PHYSICS
  BIOLOGY
  STRATEGY
  GENERAL
}

enum DecisionStatus {
  DRAFT
  REVIEWED
  DECIDED
}

enum ReviewPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ScoreKind {
  MISSION_ALIGNMENT
  IDENTITY_ALIGNMENT
  VALUE_INTEGRITY
  MENTAL_MODEL_USAGE
  FIRST_PRINCIPLE
  DECISION_QUALITY
  HABIT_CONSISTENCY
  MASTERY
  LEADERSHIP
  LEGACY
  REFLECTION
  GROWTH
}

enum MemberTier {
  FREE
  PLUS
  PRO
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MemberOrderStatus {
  CREATED
  PAID
  CANCELLED
}

// ───────────────────────────── core ─────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  personality       PersonalityState?
  transitions       PersonalityTransition[]
  worldviews        Worldview[]
  worldviewAssessments WorldviewAssessment[]
  missions          Mission[]
  visions           Vision[]
  lifeThemes        LifeTheme[]
  constitutions     Constitution[]
  identities        Identity[]
  roles             Role[]
  identityHistory   IdentityHistory[]
  values            Value[]
  valueRankings     ValueRanking[]
  valueConflicts    ValueConflict[]
  mentalModels      MentalModel[]
  modelUsageLogs    ModelUsageLog[]
  assumptions       Assumption[]
  rootCauses        RootCause[]
  constraints       Constraint[]
  firstPrincipleMaps FirstPrincipleMap[]
  decisions         Decision[]
  roleModels        RoleModel[]
  habits            Habit[]
  shadowPatterns    ShadowPattern[]
  shadowEvents      ShadowEvent[]
  interventions     Intervention[]
  reflections       Reflection[]
  lessons           Lesson[]
  reviews           Review[]
  skills            Skill[]
  leadershipMetrics LeadershipMetric[]
  // Psychology OS (migrated from emotion-sphere)
  cbtEntries        CbtEntry[]
  driverEntries     DriverEntry[]
  narrativeEntries  NarrativeEntry[]
  formationSnapshots FormationSnapshot[]
  decisionDiscernments DecisionDiscernment[]
  personaTags       PersonaTagRecord[]
  influenceLogs     InfluenceLog[]
  legacyProjects    LegacyProject[]
  mentees           Mentee[]
  knowledgeAssets   KnowledgeAsset[]
  scoreSnapshots    ScoreSnapshot[]
  events            DomainEvent[]
  beliefs           Belief[]
  beliefChangeLogs  BeliefChangeLog[]
  digitalTwin       DigitalTwinProfile?
  twinMemories      TwinMemory[]
  twinInsights      TwinInsight[]
  driftPredictions  DriftPrediction[]
  strategyAdoptions StrategyAdoption[]
  blueprintAdaptations BlueprintAdaptation[]
  learningPaths     LearningPath[]
  communityPosts    CommunityPost[]
  postComments      PostComment[]
  membership        Membership?
  membershipOrders  MembershipOrder[]

  @@map("users")
}

model PersonalityState {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     EvolutionStage @default(UNAWARE)
  progress  Float          @default(0) // 0..1 toward next stage goal
  enteredAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  @@map("personality_states")
}

model PersonalityTransition {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromStage EvolutionStage
  toStage   EvolutionStage
  reason    String         @default("")
  createdAt DateTime       @default(now())
  @@index([userId, createdAt])
  @@map("personality_transitions")
}

// ──────────────── ENGINE 1: Worldview (Layer 1) ────────────────
model Worldview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary   String   @default("") // worldview profile narrative
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dimensions WorldviewDimension[]
  @@index([userId])
  @@map("worldviews")
}

model WorldviewDimension {
  id          String   @id @default(cuid())
  worldviewId String
  worldview   Worldview @relation(fields: [worldviewId], references: [id], onDelete: Cascade)
  // e.g. "reality", "success", "failure", "human_nature", "responsibility"
  dimension   String
  stance      String   @default("")
  @@index([worldviewId])
  @@map("worldview_dimensions")
}

model WorldviewAssessment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("worldview_assessments")
}

// ──────────────── ENGINE 2: Mission (Layer 2) ────────────────
model Mission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("missions")
}

model Vision {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement String
  horizon   String   @default("10Y")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("visions")
}

model LifeTheme {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  note      String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("life_themes")
}

model Constitution {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   String
  rank      Int      @default(0)
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("constitutions")
}

// ──────────────── ENGINE 3: Identity (Layer 2) ────────────────
model Identity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  statement String   @default("")
  clarity   Float    @default(0.5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  roles  Role[]
  scores IdentityScore[]
  habitLinks HabitIdentityLink[]
  @@index([userId])
  @@map("identities")
}

model Role {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  name       String
  intention  String   @default("")
  weight     Float    @default(1)
  createdAt  DateTime @default(now())
  @@index([userId])
  @@map("roles")
}

model IdentityScore {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  alignment  Float    @default(0)
  date       DateTime @default(now())
  @@index([identityId, date])
  @@map("identity_scores")
}

model IdentityHistory {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot Json
  date     DateTime @default(now())
  @@index([userId, date])
  @@map("identity_history")
}

// ──────────────── ENGINE 4: Values (Layer 2) ────────────────
model Value {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  rankings ValueRanking[]
  @@index([userId])
  @@map("values")
}

model ValueRanking {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueId String
  value   Value  @relation(fields: [valueId], references: [id], onDelete: Cascade)
  rank    Int
  createdAt DateTime @default(now())
  @@unique([userId, valueId])
  @@index([userId, rank])
  @@map("value_rankings")
}

model ValueConflict {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueAId  String
  valueBId  String
  context   String   @default("")
  resolution String  @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("value_conflicts")
}

// ──────────────── ENGINE 5: Mental Models — Munger latticework (Layer 3) ────────────────
model MentalModel {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // Opportunity Cost, Compounding, Margin of Safety ...
  category    ModelCategory @default(GENERAL)
  description String        @default("")
  createdAt   DateTime      @default(now())

  // self-referential latticework edges
  connectionsFrom ModelConnection[] @relation("fromModel")
  connectionsTo   ModelConnection[] @relation("toModel")
  usageLogs       ModelUsageLog[]

  @@unique([userId, name])
  @@index([userId, category])
  @@map("mental_models")
}

model ModelConnection {
  id          String      @id @default(cuid())
  fromModelId String
  fromModel   MentalModel @relation("fromModel", fields: [fromModelId], references: [id], onDelete: Cascade)
  toModelId   String
  toModel     MentalModel @relation("toModel", fields: [toModelId], references: [id], onDelete: Cascade)
  relation    String      @default("relates_to") // reinforces | contradicts | composes
  createdAt   DateTime    @default(now())
  @@unique([fromModelId, toModelId, relation])
  @@map("model_connections")
}

model ModelUsageLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String
  model     MentalModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  context   String      @default("") // where it was applied (often a decision)
  date      DateTime    @default(now())
  @@index([userId, date])
  @@index([modelId])
  @@map("model_usage_logs")
}

// ──────────────── ENGINE 6: First Principles — Musk (Layer 3) ────────────────
model FirstPrincipleMap {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   String
  // zero-based redesign / decomposition tree as JSON
  tree      Json?
  createdAt DateTime @default(now())

  assumptions Assumption[]
  rootCauses  RootCause[]
  constraints Constraint[]
  @@index([userId])
  @@map("first_principle_maps")
}

model Assumption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId     String?
  map       FirstPrincipleMap? @relation(fields: [mapId], references: [id], onDelete: SetNull)
  statement String
  valid     Boolean? // null = untested; result of the "assumption killer"
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("assumptions")
}

model RootCause {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId     String?
  map       FirstPrincipleMap? @relation(fields: [mapId], references: [id], onDelete: SetNull)
  cause     String
  depth     Int      @default(1) // 5-whys depth
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("root_causes")
}

model Constraint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId     String?
  map       FirstPrincipleMap? @relation(fields: [mapId], references: [id], onDelete: SetNull)
  statement String
  kind      String   @default("PHYSICAL") // PHYSICAL | ECONOMIC | REGULATORY | SELF_IMPOSED
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("constraints")
}

// ──────────────── ENGINE 7: Decisions (Layer 3/4) ────────────────
model Decision {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  context   String         @default("")
  status    DecisionStatus @default(DRAFT)
  quality   Float?
  reversible Boolean       @default(true)
  createdAt DateTime       @default(now())

  options DecisionOption[]
  reviews DecisionReview[]
  @@index([userId])
  @@map("decisions")
}

model DecisionOption {
  id         String   @id @default(cuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  label      String
  chosen     Boolean  @default(false)
  createdAt  DateTime @default(now())
  reviews DecisionReview[]
  @@index([decisionId])
  @@map("decision_options")
}

model DecisionReview {
  id             String   @id @default(cuid())
  decisionId     String
  decision       Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  optionId       String?
  option         DecisionOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  missionFit     Float    @default(0)
  identityFit    Float    @default(0)
  valueFit       Float    @default(0)
  expectedValue  Float    @default(0) // 0..1 normalized
  opportunityCost Float   @default(0)
  secondOrder    Float    @default(0) // 0..1 quality of 2nd-order thinking
  risk           Float    @default(0)
  reversibility  Float    @default(0.5)
  shadowMotive   Float    @default(0) // penalty
  quality        Float    @default(0) // composite
  note           String   @default("")
  createdAt      DateTime @default(now())
  @@index([decisionId])
  @@map("decision_reviews")
}

// ──────────────── ENGINE 8: Excellence Modeling — Dilts (Layer 3) ────────────────
model RoleModel {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    String
  archetype ModelArchetype @default(CUSTOM)
  values    String         @default("")
  beliefs   String         @default("")
  environment String       @default("")
  createdAt DateTime       @default(now())

  identityPatterns IdentityPattern[]
  decisionPatterns DecisionPattern[]
  habitPatterns    HabitPattern[]
  @@index([userId])
  @@map("role_models")
}

model IdentityPattern {
  id          String    @id @default(cuid())
  roleModelId String
  roleModel   RoleModel @relation(fields: [roleModelId], references: [id], onDelete: Cascade)
  pattern     String
  @@index([roleModelId])
  @@map("identity_patterns")
}

model DecisionPattern {
  id          String    @id @default(cuid())
  roleModelId String
  roleModel   RoleModel @relation(fields: [roleModelId], references: [id], onDelete: Cascade)
  rule        String
  @@index([roleModelId])
  @@map("decision_patterns")
}

model HabitPattern {
  id          String    @id @default(cuid())
  roleModelId String
  roleModel   RoleModel @relation(fields: [roleModelId], references: [id], onDelete: Cascade)
  habit       String
  @@index([roleModelId])
  @@map("habit_patterns")
}

// ──────────────── ENGINE 9: Habits (Layer 4) ────────────────
model Habit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  identityProof String   @default("")
  targetPerWeek Int      @default(7)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  logs          HabitLog[]
  identityLinks HabitIdentityLink[]
  @@index([userId])
  @@map("habits")
}

model HabitLog {
  id           String   @id @default(cuid())
  habitId      String
  habit        Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  done         Boolean  @default(true)
  identityNote String   @default("")
  createdAt    DateTime @default(now())
  @@index([habitId, date])
  @@map("habit_logs")
}

model HabitIdentityLink {
  id         String   @id @default(cuid())
  habitId    String
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([habitId, identityId])
  @@index([habitId])
  @@map("habit_identity_links")
}

// ──────────────── ENGINE 10: Shadow (cross-cutting) ────────────────
model ShadowPattern {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ShadowType
  rootCause String     @default("")
  createdAt DateTime   @default(now())

  events        ShadowEvent[]
  interventions Intervention[]
  @@index([userId, type])
  @@map("shadow_patterns")
}

model ShadowEvent {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String?
  pattern   ShadowPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  type      ShadowType
  trigger   String        @default("")
  severity  Float         @default(0.5)
  date      DateTime      @default(now())
  @@index([userId, date])
  @@map("shadow_events")
}

model Intervention {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String?
  pattern   ShadowPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  action    String
  createdAt DateTime      @default(now())
  @@index([userId])
  @@map("interventions")
}

// ──────────────── ENGINE 11: Reflection — Dalio (Layer 4) ────────────────
model Reflection {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime @default(now())
  worked             String   @default("")
  failed             String   @default("")
  learned            String   @default("")
  wrongAssumptions   String   @default("")
  identityReinforced String   @default("")
  depth              Float    @default(0.5)
  lessons Lesson[]
  @@index([userId, date])
  @@map("reflections")
}

model Lesson {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflectionId String?
  reflection   Reflection? @relation(fields: [reflectionId], references: [id], onDelete: SetNull)
  text         String
  createdAt    DateTime @default(now())
  @@index([userId])
  @@map("lessons")
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    ReviewPeriod
  periodKey String // "2026-06-02" | "2026-W23" | "2026-06" | "2026-Q2"
  summary   String       @default("")
  metrics   Json?
  createdAt DateTime     @default(now())
  @@unique([userId, period, periodKey])
  @@index([userId, period])
  @@map("reviews")
}

// ──────────────── ENGINE 12: Mastery (Layer 4) ────────────────
model Skill {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  domain    String   @default("")
  createdAt DateTime @default(now())

  masteryLevel MasteryLevel?
  progress     SkillProgress[]
  @@index([userId])
  @@map("skills")
}

model MasteryLevel {
  id           String       @id @default(cuid())
  skillId      String       @unique
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  stage        MasteryStage @default(NOVICE)
  knowledge    Float        @default(0)
  execution    Float        @default(0)
  problemSolving Float      @default(0)
  teaching     Float        @default(0)
  updatedAt    DateTime     @updatedAt
  @@map("mastery_levels")
}

model SkillProgress {
  id      String   @id @default(cuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  note    String   @default("")
  delta   Float    @default(0)
  date    DateTime @default(now())
  @@index([skillId, date])
  @@map("skill_progress")
}

// ──────────────── ENGINE 13: Leadership (Layer 4) ────────────────
model LeadershipMetric {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication Float  @default(0) // 0..1
  influence   Float    @default(0)
  delegation  Float    @default(0)
  teamBuilding Float   @default(0)
  decisionQuality Float @default(0)
  date        DateTime @default(now())
  @@index([userId, date])
  @@map("leadership_metrics")
}

model InfluenceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  who       String   @default("")
  outcome   String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("influence_logs")
}

// ──────────────── ENGINE 14: Legacy (Layer 4) ────────────────
model LegacyProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("INSTITUTION")
  impact    String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("legacy_projects")
}

model Mentee {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  focus     String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("mentees")
}

model KnowledgeAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("ARTICLE")
  url       String   @default("")
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("knowledge_assets")
}

// ──────────────── Scoring + Event store ────────────────
model ScoreSnapshot {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   ScoreKind
  value  Float
  detail Json?
  date   DateTime  @default(now())
  @@index([userId, kind, date])
  @@map("score_snapshots")
}

model DomainEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  version       Int      @default(1)
  occurredAt    DateTime @default(now())
  @@index([userId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

// ──────────────── Belief Engine ────────────────
enum BeliefType {
  LIMITING
  EMPOWERING
  NEUTRAL
}

model Belief {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement String
  type      BeliefType @default(NEUTRAL)
  strength  Float      @default(0.5)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  limiting   LimitingBelief?
  empowering EmpoweringBelief?
  reframes   BeliefReframe[]

  @@index([userId, type])
  @@map("beliefs")
}

model LimitingBelief {
  id        String   @id @default(cuid())
  beliefId  String   @unique
  belief    Belief   @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  trigger   String   @default("")
  cost      String   @default("")
  createdAt DateTime @default(now())
  @@map("limiting_beliefs")
}

model EmpoweringBelief {
  id        String   @id @default(cuid())
  beliefId  String   @unique
  belief    Belief   @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  evidence  String   @default("")
  createdAt DateTime @default(now())
  @@map("empowering_beliefs")
}

model BeliefReframe {
  id             String   @id @default(cuid())
  beliefId       String
  belief         Belief   @relation(fields: [beliefId], references: [id], onDelete: Cascade)
  reframedText   String
  empoweringText String   @default("")
  action         String   @default("")
  createdAt      DateTime @default(now())
  @@index([beliefId])
  @@map("belief_reframes")
}

model BeliefChangeLog {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  beliefId  String?
  fromType  BeliefType
  toType    BeliefType
  note      String     @default("")
  createdAt DateTime   @default(now())
  @@index([userId])
  @@map("belief_change_logs")
}

// ──────────────── Digital Twin ────────────────
model DigitalTwinProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Serialized snapshot of mission/identity/values/habits/etc. for fast reads.
  snapshot  Json?
  summary   String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@map("digital_twin_profiles")
}

model TwinMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("EVENT") // EVENT | INSIGHT | DECISION | REFLECTION
  content   String
  weight    Float    @default(0.5)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("twin_memories")
}

model TwinInsight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insight   String
  basis     String   @default("")
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("twin_insights")
}

model DriftPrediction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  risk        Float    @default(0) // 0..1 identity-drift risk
  fromIdentity String  @default("")
  towardIdentity String @default("")
  rationale   String   @default("")
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@map("drift_predictions")
}

// ──────────────── Genius Strategies (Strategies of Genius × NLP Modeling) ────────────────
// Captures not just WHAT a genius believed (Dilts logical levels) but HOW they
// thought — the micro-strategy as a representational-system sequence (V/A/K/Ad)
// and a T.O.T.E. loop — so it can be installed and practiced by a user.
model Genius {
  id        String   @id @default(cuid())
  name      String   @unique
  era       String   @default("")
  domain    String   @default("")
  summary   String   @default("")
  createdAt DateTime @default(now())

  strategies GeniusStrategy[]
  @@map("geniuses")
}

model GeniusStrategy {
  id           String   @id @default(cuid())
  geniusId     String
  genius       Genius   @relation(fields: [geniusId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  // [{ step, system: "V"|"A"|"K"|"Ad", description }]
  repSequence  Json?
  // { test, operate, testExit, exit } — the T.O.T.E. control loop
  tote         Json?
  // High-leverage logical levels (the point of leverage is identity/values/beliefs)
  identity     String   @default("")
  beliefs      String   @default("")
  values       String   @default("")
  capabilities String   @default("")
  highLeverage String   @default("")
  // Full Excellence Blueprint dimensions (reverse-engineering "how", not biography)
  creativeProcess String @default("")
  learningProcess String @default("")
  feedbackProcess String @default("")
  shadowPatterns  String @default("")
  failureModes    String @default("")
  // string[] — how a user installs/practices this strategy
  installProtocol Json?
  createdAt    DateTime @default(now())

  adoptions StrategyAdoption[]
  adaptations BlueprintAdaptation[]
  @@index([geniusId])
  @@map("genius_strategies")
}

model StrategyAdoption {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String
  strategy   GeniusStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  status     String   @default("ADOPTED") // ADOPTED | PRACTICING | INTEGRATED
  note       String   @default("")
  createdAt  DateTime @default(now())

  logs GeniusPracticeLog[]
  @@unique([userId, strategyId])
  @@index([userId])
  @@map("strategy_adoptions")
}

model GeniusPracticeLog {
  id         String   @id @default(cuid())
  adoptionId String
  adoption   StrategyAdoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  reflection String   @default("")
  fidelity   Float    @default(0.5) // how faithfully the strategy was reproduced, 0..1
  date       DateTime @default(now())
  @@index([adoptionId, date])
  @@map("genius_practice_logs")
}

// ──────────────── Excellence Reverse Engineering: adaptation + learning path ────────────────
// Persona Adaptation: convert a genius blueprint into a blueprint adapted to THIS user.
model BlueprintAdaptation {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId       String
  strategy         GeniusStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  title            String   // e.g. "Leonardo-inspired Research Architect"
  identity         String   @default("")
  beliefs          String   @default("")
  values           String   @default("")
  decisionRules    Json?    // string[]
  habits           Json?    // string[]
  creativeProcess  String   @default("")
  summary          String   @default("")
  createdAt        DateTime @default(now())

  paths LearningPath[]
  @@index([userId])
  @@map("blueprint_adaptations")
}

// Excellence Learning Loop: Observe → Imitate → Practice → Internalize → Adapt → Create → Teach.
model LearningPath {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adaptationId String?
  adaptation   BlueprintAdaptation? @relation(fields: [adaptationId], references: [id], onDelete: SetNull)
  strategyId   String?
  title        String
  createdAt    DateTime @default(now())

  steps LearningStep[]
  @@index([userId])
  @@map("learning_paths")
}

model LearningStep {
  id        String   @id @default(cuid())
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  stage     String   // OBSERVE | IMITATE | PRACTICE | INTERNALIZE | ADAPT | CREATE | TEACH
  order     Int      @default(0)
  action    String   @default("")
  done      Boolean  @default(false)
  doneAt    DateTime?
  createdAt DateTime @default(now())
  @@index([pathId, order])
  @@map("learning_steps")
}

// ──────────────── Online Community ────────────────
model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("") // key from the status library (see lib/community/statuses.ts)
  message   String   @default("")
  createdAt DateTime @default(now())

  comments PostComment[]
  @@index([userId])
  @@index([createdAt])
  @@map("community_posts")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  @@index([postId, createdAt])
  @@map("post_comments")
}

// ──────────────── Membership / Subscription ────────────────
model Membership {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      MemberTier    @default(FREE)
  period    BillingPeriod?
  status    String        @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  startedAt DateTime      @default(now())
  expiresAt DateTime?
  updatedAt DateTime      @updatedAt
  @@map("memberships")
}

model MembershipOrder {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       MemberTier
  period     BillingPeriod
  amount     Decimal           @db.Decimal(10, 2)
  currency   String            @default("CNY")
  status     MemberOrderStatus @default(CREATED)
  provider   String            @default("mock") // mock | alipay | wechat
  outTradeNo String            @unique
  createdAt  DateTime          @default(now())
  paidAt     DateTime?
  @@index([userId])
  @@map("membership_orders")
}
