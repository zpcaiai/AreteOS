// Stateful authentication, consent evidence, and distributed abuse controls.

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  ipHash     String?
  userAgent  String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}

model LegalConsent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  acceptedAt DateTime @default(now())
  ipHash     String?
  userAgent  String?

  @@index([userId, document, acceptedAt])
  @@map("legal_consents")
}

model RegistrationInvite {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  invitedById String
  teamId      String?
  teamRole    String    @default("member")
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([teamId])
  @@map("registration_invites")
}

model GuardianConsent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianName String
  relationship String
  version      String
  acceptedAt   DateTime  @default(now())
  revokedAt    DateTime?
  ipHash       String?
  userAgent    String?

  @@index([userId, acceptedAt])
  @@map("guardian_consents")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// Security evidence intentionally has no User foreign key: account deletion must
// not erase the immutable record that a privileged or destructive action occurred.
model SecurityAuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  outcome    String   @default("success")
  metadata   Json?
  requestId  String?
  ipHash     String?
  userAgent  String?
  occurredAt DateTime @default(now())

  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@map("security_audit_events")
}
