// ============================================================================
// Cognitive OS — "The Judgment and Decision Operating System."
// Inspired by widely-taught ideas: a latticework of mental models, judgment &
// decision quality, cognitive biases, reasoning under uncertainty, strategic
// diagnosis, and turning reflection into wisdom. The curated library is namespaced
// Cog* to stay distinct from the per-user MentalModel engine.
// ============================================================================

enum CogCategory {
  ECONOMICS
  PSYCHOLOGY
  SYSTEMS_THINKING
  PROBABILITY
  BIOLOGY
  PHYSICS
  STRATEGY
  INNOVATION
  DECISION_SCIENCE
  GENERAL
}

model CogModel {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  category  CogCategory @default(GENERAL)
  summary   String      @default("")
  whenToUse String      @default("")
  examples  String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category])
  @@map("cog_models")
}

model CogModelRelationship {
  id        String   @id @default(cuid())
  fromSlug  String
  toSlug    String
  relation  String   @default("relates-to")
  createdAt DateTime @default(now())

  @@index([fromSlug])
  @@map("cog_model_relationships")
}

model CogModelCluster {
  id         String   @id @default(cuid())
  name       String
  purpose    String   @default("")
  modelSlugs String[] @default([])
  createdAt  DateTime @default(now())

  @@map("cog_model_clusters")
}

model CogModelExample {
  id        String   @id @default(cuid())
  modelSlug String
  example   String
  createdAt DateTime @default(now())

  @@index([modelSlug])
  @@map("cog_model_examples")
}

model DecisionLens {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  question  String   @default("")
  createdAt DateTime @default(now())

  @@map("cog_decision_lenses")
}

model DecisionLensResult {
  id         String   @id @default(cuid())
  userId     String
  decision   String
  lenses     Json?
  confidence Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("cog_decision_lens_results")
}

model Bias {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  correction  String   @default("")
  createdAt   DateTime @default(now())

  @@map("cog_biases")
}

model BiasEvent {
  id        String   @id @default(cuid())
  userId    String
  biasSlug  String
  biasName  String
  context   String   @default("")
  severity  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("cog_bias_events")
}

model JudgmentProfile {
  id            String   @id @default(cuid())
  userId        String
  judgmentScore Float    @default(0)
  blindSpots    String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("cog_judgment_profiles")
}

model JudgmentAssessment {
  id                  String   @id @default(cuid())
  userId              String
  problemFraming      Float    @default(0)
  evidenceQuality     Float    @default(0)
  modelDiversity      Float    @default(0)
  biasResistance      Float    @default(0)
  longTermThinking    Float    @default(0)
  secondOrderThinking Float    @default(0)
  riskAwareness       Float    @default(0)
  decisionClarity     Float    @default(0)
  judgmentScore       Float    @default(0)
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("cog_judgment_assessments")
}

model DecisionJournal {
  id              String   @id @default(cuid())
  userId          String
  decision        String
  context         String   @default("")
  expectedOutcome String   @default("")
  actualOutcome   String   @default("")
  modelsUsed      String[] @default([])
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("cog_decision_journals")
}

model DecisionAssumption {
  id         String   @id @default(cuid())
  journalId  String
  assumption String
  heldTrue   Boolean?
  createdAt  DateTime @default(now())

  @@index([journalId])
  @@map("cog_decision_assumptions")
}

model DecisionOutcome {
  id        String   @id @default(cuid())
  journalId String
  outcome   String
  surprise  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([journalId])
  @@map("cog_decision_outcomes")
}

model CogDecisionReview {
  id               String   @id @default(cuid())
  userId           String
  journalId        String
  lessons          String[] @default([])
  failedModel      String   @default("")
  wrongAssumptions String[] @default([])
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([journalId])
  @@map("cog_decision_reviews")
}

model Latticework {
  id          String   @id @default(cuid())
  userId      String
  goal        String
  blindSpots  String[] @default([])
  synergyNote String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("cog_latticeworks")
}

model LatticeworkNode {
  id            String   @id @default(cuid())
  latticeworkId String
  modelSlug     String
  modelName     String
  category      String   @default("")
  createdAt     DateTime @default(now())

  @@index([latticeworkId])
  @@map("cog_latticework_nodes")
}

model LatticeworkEdge {
  id            String   @id @default(cuid())
  latticeworkId String
  fromModel     String
  toModel       String
  relation      String   @default("")
  createdAt     DateTime @default(now())

  @@index([latticeworkId])
  @@map("cog_latticework_edges")
}

model CognitiveProfile {
  id             String   @id @default(cuid())
  userId         String
  thinkingStyle  String   @default("")
  decisionStyle  String   @default("")
  learningStyle  String   @default("")
  reasoningStyle String   @default("")
  riskStyle      String   @default("")
  strengths      String[] @default([])
  weaknesses     String[] @default([])
  globalScore    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("cog_cognitive_profiles")
}

model ThinkingPattern {
  id        String   @id @default(cuid())
  userId    String
  pattern   String
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("cog_thinking_patterns")
}

model ReasoningStyle {
  id        String   @id @default(cuid())
  userId    String
  style     String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("cog_reasoning_styles")
}

model UncertaintyAssessment {
  id                String   @id @default(cuid())
  userId            String
  robustness        Float    @default(0)
  fragility         Float    @default(0)
  optionality       Float    @default(0)
  tailRiskAwareness Float    @default(0)
  uncertaintyScore  Float    @default(0)
  profile           String   @default("")
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("cog_uncertainty_assessments")
}

model Optionality {
  id             String   @id @default(cuid())
  userId         String
  option         String
  upside         String   @default("")
  cappedDownside Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("cog_optionalities")
}

model TailRisk {
  id         String   @id @default(cuid())
  userId     String
  risk       String
  exposure   Float    @default(0)
  mitigation String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("cog_tail_risks")
}

model Diagnosis {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  diagnosis String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("cog_diagnoses")
}

model CogRootCause {
  id          String   @id @default(cuid())
  diagnosisId String
  rootCause   String
  createdAt   DateTime @default(now())

  @@index([diagnosisId])
  @@map("cog_root_causes")
}

model LeveragePoint {
  id          String   @id @default(cuid())
  diagnosisId String
  leverage    String
  impact      Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([diagnosisId])
  @@map("cog_leverage_points")
}

model WisdomInsight {
  id        String   @id @default(cuid())
  userId    String
  insight   String
  basis     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("cog_wisdom_insights")
}

model PersonalPrinciple {
  id        String   @id @default(cuid())
  userId    String
  principle String
  rationale String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("cog_personal_principles")
}
