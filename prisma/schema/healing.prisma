  sessionId                 String
  mode                      String
  currentIdentityPain       String
  relatedFormulationId      String?
  relatedBeliefRecordId     String?

  identityMap               Json
  missionRecovery           Json
  dailyEvidencePlan         Json
  identityPracticeTask      Json
  integrationSummary        String
  nextRecommendedSkills     Json
  cautions                  Json

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  evidences                 IdentityEvidence[]

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("healing_identity_sessions")
