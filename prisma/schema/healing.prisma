// ───────────────────────── Healing OS (Robot Dilts) ─────────────────────────
// Self-contained "healing" namespace: the safety gate, the structured intake
// snapshot, and the Dilts six-level + 5P clinical-style formulation. NOT a
// diagnosis store. Nested analysis is kept as Json to stay faithful to the
// domain Zod shapes (src/lib/domain/{risk,mental-state,dilts}.ts) without
// over-normalizing. Bridges to the existing Psychology OS (CbtEntry,
// DriverEntry, NarrativeEntry) are made by reference in a later batch.

/// Every safety-triage decision is appended here (audit trail). The highest-risk
/// classifications come from deterministic rules, not the LLM — see
/// src/lib/healing/safety-rules.ts.
model SafetyTriageEvent {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String

  inputMessage      String
  riskLevel         String   // green | yellow | orange | red
  riskDomains       Json     // RiskDomain[]
  confidence        Float    @default(0.5)
  detectedSignals   Json     // DetectedSignal[]
  recommendedRoute  String

  userFacingMessage String
  allowedNextSkills Json     // string[]
  blockedSkills     Json     // string[]
  safetyPlan        Json?    // SafetyPlan

  overridden        Boolean  @default(false) // a rule escalated the LLM level
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([riskLevel])
  @@map("safety_triage_events")
}

/// Structured snapshot of current state (mood/anxiety/function/loops). One row
/// per intake; the formulation references the latest.
model MentalStateIntake {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String

  freeText            String?
  ratings             Json?    // IntakeRatings
  checkboxes          Json?    // IntakeCheckboxes

  summary             String
  primaryConcerns     Json     // { concern, severity, evidence }[]
  emotionalProfile    Json     // { dominantEmotions, intensityPattern, bodySignals }
  functionalImpact    Json     // { workOrStudy, relationships, selfCare, sleep }
  maintainingLoops    Json     // MaintainingLoop[]
  suggestedNextSkills Json     // NextSkill[]

  riskLevelAtIntake   String   @default("green")
  createdAt           DateTime @default(now())

  formulations        DiltsClinicalFormulation[]

  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("mental_state_intakes")
}

/// Dilts six-level map + 5P formulation + causal loop + recommended path.
model DiltsClinicalFormulation {
  id                          String             @id @default(cuid())
  userId                      String
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId                   String
  intakeId                    String?
  intake                      MentalStateIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  problemStatement            String
  depth                       String             @default("standard") // light|standard|deep|shallow

  diltsMap                    Json               // DiltsMap
  fiveP                       Json               // FiveP
  causalLoop                  Json               // CausalLoopEdge[]
  formulationSummary          String
  recommendedInterventionPath Json               // InterventionStep[]
  cautions                    Json               // string[]

  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([intakeId])
  @@map("dilts_clinical_formulations")
}

/// Shared practice spine. CBT / emotion-regulation / parts-work / exposure /
/// identity all create small, measurable tasks here; the timeline reads
/// completion stats. sourceType+sourceId link back to the producing record.
model PracticeTask {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String

  sourceType       String    // cbt | emotion-regulation | core-belief | parts-work | exposure | identity | ...
  sourceId         String?

  title            String
  description      String    @default("")
  steps            Json      // string[]
  difficulty       String    @default("easy")
  status           String    @default("pending") // pending | in_progress | completed | skipped
  completionMetric String    @default("")

  scheduledFor     DateTime?
  completedAt      DateTime?
  reflection       Json?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([sourceType, sourceId])
  @@map("healing_practice_tasks")
}

