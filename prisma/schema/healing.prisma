model ExposurePlan {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId             String
  avoidanceProblem      String
  relatedCBTSessionId   String?
  relatedBeliefRecordId String?
  relatedFormulationId  String?

  blocked               Boolean           @default(false)
  blockReason           String?
  avoidanceLoop         Json?
  exposureType          String?
  hierarchy             Json?
  selectedExperiment    Json?
  reflectionTemplate    Json?
  practiceTask          Json?
  nextRecommendedSkills Json?
  cautions              Json?

  attempts              ExposureAttempt[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([relatedCBTSessionId])
  @@map("healing_exposure_plans")
}

model ExposureAttempt {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String
  exposurePlanId      String
  plan                ExposurePlan @relation(fields: [exposurePlanId], references: [id], onDelete: Cascade)

  hierarchyLevel      Int
  beforeDistress      Int?
  peakDistress        Int?
  afterDistress       Int?
  actualOutcome       String?
  learningStatement   String?
  safetyBehaviorsUsed Json?
  completed           Boolean      @default(false)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([exposurePlanId])
  @@map("healing_exposure_attempts")
}

// ───────────────────────── Healing OS · Batch 4 (long-term growth) ─────────────────────────

