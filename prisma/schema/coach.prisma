// Coach OS — stateful multi-turn coaching conversations.
//
// Unlike the single-shot agents (src/lib/agents/*), a CoachSession carries
// conversation history across turns, and the coach can call read-only tools
// (score history, recent decisions, reflections, memory recall) to ground its
// answers in the user's actual data.

enum CoachSessionStatus {
  ACTIVE
  ARCHIVED
}

model CoachSession {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String             @default("")
  /// Optional engine focus, e.g. "decisions" | "habits" | "naval" | "" (general).
  focus     String             @default("")
  status    CoachSessionStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  messages CoachMessage[]

  @@index([userId, status, updatedAt])
  @@map("coach_sessions")
}

model CoachMessage {
  id        String       @id @default(cuid())
  sessionId String       @map("session_id")
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role      String
  content   String
  /// Names + arguments of any tools the coach called while producing this turn.
  toolCalls Json?        @map("tool_calls")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("coach_messages")
}
