# ============================================================================
# AreteOS — Production environment template (for Vercel)
# ----------------------------------------------------------------------------
# HOW TO USE: Vercel does NOT read this file. Copy each key/value into
#   Vercel → Project → Settings → Environment Variables
#   (scope: Production; also tick Preview if you want preview deploys to work),
# then redeploy. This file is a checklist/reference only.
#
# Do NOT paste real secrets here and commit them. Keep real values in Vercel,
# or in an untracked .env.production / .env.local (both are gitignored).
#
# MINIMUM TO GO LIVE:
#   DATABASE_URL + DIRECT_URL + AUTH_SECRET + NEXT_PUBLIC_SITE_URL
#   + AI_PROVIDER=mock + (DEV_USER_ID=usr_demo  OR  AUTH_REQUIRED=true)
# ============================================================================


# ---- 1) Database (REQUIRED) — Neon Postgres --------------------------------
# Pooled = runtime (serverless-friendly). Neon → Connection string → "Pooled".
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct = migrations. `prisma migrate deploy` uses this. Neon → "Direct".
DIRECT_URL="postgresql://USER:PASSWORD@EP-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"


# ---- 2) Auth / session (REQUIRED) ------------------------------------------
# HMAC secret for signing session cookies. Without it the app falls back to an
# insecure dev default. Generate:  openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_run_openssl_rand_hex_32"


# ---- 3) Access mode (CHOOSE ONE) -------------------------------------------
# (A) Demo / single-user: skip login, use the seeded PRO demo account.
DEV_USER_ID="usr_demo"
# AUTH_REQUIRED="false"
#
# (B) Real multi-user login: force login; users register at /login.
#     -> set AUTH_REQUIRED="true" AND remove/comment DEV_USER_ID above.
# AUTH_REQUIRED="true"


# ---- 4) AI provider --------------------------------------------------------
# mock = free / offline; agents return example output (fully functional demo).
# Switch to openai or anthropic + a key when you want real model calls.
AI_PROVIDER="mock"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"


# ---- 5) Public site URL (RECOMMENDED) --------------------------------------
# Your production domain — used for SEO / OpenGraph / share-card links.
NEXT_PUBLIC_SITE_URL="https://YOUR-APP.vercel.app"


# ---- 6) Weekly growth-card cron (set to enable) ----------------------------
# vercel.json already schedules /api/cron/weekly (Mondays 09:00 UTC).
# This secret authenticates that call (sent as Authorization: Bearer <secret>).
# Generate: openssl rand -hex 32  (or reuse the value already in your local .env)
CRON_SECRET="CHANGE_ME_run_openssl_rand_hex_32"


# ---- 7) Admin panel (RECOMMENDED) ------------------------------------------
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS="zpchoney@gmail.com"


# ============================================================================
# OPTIONAL — leave unset to disable the feature / use the built-in default.
# ============================================================================
# Knowledge graph (inert unless all three are set)
# NEO4J_HTTP_URL=""
# NEO4J_USER=""
# NEO4J_PASSWORD=""

# Naval Life OS: record a daily score snapshot per user in the nightly job
# NAVAL_NIGHTLY="false"

# Observability (error reporting stays off unless a DSN is set)
# LOG_LEVEL="info"
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.05"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.02"

# API safety limits (defaults are fine)
# MAX_JSON_BODY_CHARS="24000"
# MAX_AGENT_BODY_CHARS="24000"
# AGENT_RATE_LIMIT="30"
# AGENT_RATE_WINDOW_MS="60000"
# COACH_RATE_LIMIT="20"
# COACH_RATE_WINDOW_MS="60000"

# Background-job concurrency
# NIGHTLY_CONCURRENCY="8"
# WEEKLY_CONCURRENCY="8"

# Payment webhooks (mock checkout works without these)
# ALIPAY_WEBHOOK_SECRET=""
# WECHAT_PAY_WEBHOOK_SECRET=""

# NOTE: APP_URL / LANGGRAPH_URL / AGENT_ORCHESTRATOR are NOT needed on Vercel.
# APP_URL is only used by the standalone server-crontab script (scripts/weekly-cron.sh).
