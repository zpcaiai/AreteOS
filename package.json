{
  "name": "mission-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-genius.ts && tsx prisma/seed-identity.ts && tsx prisma/seed-cognitive.ts && tsx prisma/seed-worldview.ts && tsx prisma/seed-audiobooks.ts && tsx prisma/seed-emporion.ts && tsx prisma/seed-naval.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:agents": "tsx scripts/evaluate-agents.ts",
    "nightly": "tsx scripts/nightly.ts",
    "db:seed:genius": "tsx prisma/seed-genius.ts",
    "db:seed:identity": "tsx prisma/seed-identity.ts",
    "db:seed:cognitive": "tsx prisma/seed-cognitive.ts",
    "db:seed:worldview": "tsx prisma/seed-worldview.ts",
    "db:seed:audiobooks": "tsx prisma/seed-audiobooks.ts",
    "db:seed:emporion": "tsx prisma/seed-emporion.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && (prisma migrate deploy || echo \"migrate skipped — set DATABASE_URL in Vercel to enable\") && next build",
    "analyze": "ANALYZE=true next build",
    "db:seed:naval": "tsx prisma/seed-naval.ts",
    "weekly": "tsx scripts/weekly.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.57.0",
    "@tanstack/react-query": "^5.101.0",
    "next": "^15.1.4",
    "pino": "^10.3.1",
    "postprocessing": "^6.36.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.1.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
