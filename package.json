{
  "name": "mission-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push:healing": "docker compose up -d --force-recreate --wait && docker compose exec -T db psql -U postgres -d mission_os -c \"CREATE EXTENSION IF NOT EXISTS vector\" && prisma db push",
    "db:reset:healing": "docker compose down -v && docker compose up -d --wait && docker compose exec -T db psql -U postgres -d mission_os -c \"CREATE EXTENSION IF NOT EXISTS vector\" && prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-genius.ts && tsx prisma/seed-identity.ts && tsx prisma/seed-cognitive.ts && tsx prisma/seed-worldview.ts && tsx prisma/seed-audiobooks.ts && tsx prisma/seed-emporion.ts && tsx prisma/seed-naval.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:agents": "tsx scripts/evaluate-agents.ts",
    "nightly": "tsx scripts/nightly.ts",
    "db:seed:genius": "tsx prisma/seed-genius.ts",
    "db:seed:identity": "tsx prisma/seed-identity.ts",
    "db:seed:cognitive": "tsx prisma/seed-cognitive.ts",
    "db:seed:worldview": "tsx prisma/seed-worldview.ts",
    "db:seed:audiobooks": "tsx prisma/seed-audiobooks.ts",
    "db:seed:emporion": "tsx prisma/seed-emporion.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "analyze": "ANALYZE=true next build",
    "db:seed:naval": "tsx prisma/seed-naval.ts",
    "weekly": "tsx scripts/weekly.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "eval:scenarios": "tsx scripts/eval-scenarios.ts",
    "check:clinical": "tsx scripts/clinical-gate.ts",
    "check:release": "tsx scripts/release-gate.ts",
    "check:release:paid": "tsx scripts/release-gate.ts --profile=paid",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "verify:restore": "tsx scripts/verify-restore.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.66.0",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^7.0.30",
    "next": "^16.2.10",
    "pino": "^10.3.1",
    "postprocessing": "^6.39.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.1.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.19",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
