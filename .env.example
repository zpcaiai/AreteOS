# ===== Neon Postgres (Vercel → Project → Settings → Environment Variables) =====
# Pooled connection (runtime, serverless-friendly). Neon "Pooled connection" string.
DATABASE_URL="postgresql://<user>:<pwd>@<ep>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (migrations / db push). Neon "Direct connection" string.
DIRECT_URL="postgresql://<user>:<pwd>@<ep>.<region>.aws.neon.tech/<db>?sslmode=require"

# ===== Auth & app =====
AUTH_SECRET="<at-least-32-random-bytes>" # IP pseudonymization and security controls
AUTH_REQUIRED="true"                    # production enforces this regardless
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# closed = existing users only; invite = one-time database invitation; open = public signup
REGISTRATION_MODE="closed"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Arete <account@example.com>"
# Pending clinical modules remain unavailable in production unless a controlled
# preview explicitly enables them. Do not enable for paid/default use before sign-off.
CLINICAL_PREVIEW_ENABLED="false"
CLINICAL_FEATURE_ENABLED="false"
CHILD_FEATURE_ENABLED="false"
CHILD_GUARDIAN_CONSENT_ENABLED="false"
ENTERPRISE_RBAC_ENABLED="true"
# DEV_USER_ID=                        # leave UNSET in prod

# ===== AI provider (mock runs fully offline; set real keys to go live) =====
AI_PROVIDER="mock"                    # mock | openai | anthropic | ollama
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

# ===== Optional Neo4j knowledge graph (inert unless set) =====
NEO4J_HTTP_URL=""
NEO4J_USER=""
NEO4J_PASSWORD=""

# ===== Admin panel (/admin) — comma-separated emails allowed into the admin =====
ADMIN_EMAILS="you@example.com"

# Absolute site URL (for SEO / OpenGraph metadata)
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Naval Life OS: set true so the nightly job records a daily score snapshot per user
NAVAL_NIGHTLY=false

# Observability
OBSERVABILITY_PROVIDER="vercel" # vercel | sentry
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.02"

# API safety limits
MAX_JSON_BODY_CHARS=24000
MAX_AGENT_BODY_CHARS=24000
AGENT_RATE_LIMIT=30
AGENT_RATE_WINDOW_MS=60000

# Payments. Server chooses the provider; clients cannot select or self-activate.
# For local payment simulation only: PAYMENT_PROVIDER=mock and PAYMENT_MOCK_ENABLED=true.
PAYMENTS_ENABLED="false"
PAYMENT_REFUNDS_ENABLED="false"
PAYMENT_PROVIDER="" # alipay | wechat (mock is rejected in production)
PAYMENT_MOCK_ENABLED="false"
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL=""
ALIPAY_RETURN_URL=""
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PLATFORM_PUBLIC_KEY=""
WECHAT_PAY_PLATFORM_SERIAL_NO=""
WECHAT_PAY_NOTIFY_URL=""
WECHAT_PAY_REFUND_NOTIFY_URL=""

# ===== Release profile and commercial release attestations =====
# pilot | paid | clinical | family | enterprise
RELEASE_PROFILE="pilot"

# Required for paid profiles. Values are rendered into /privacy and /terms.
LEGAL_ENTITY_NAME=""
LEGAL_ENTITY_ADDRESS=""
SUPPORT_EMAIL=""
PRIVACY_EMAIL=""
GOVERNING_LAW=""
DISPUTE_RESOLUTION=""
REFUND_POLICY=""
SUBPROCESSORS=""
DATA_REGIONS=""
TERMS_VERSION=""
PRIVACY_VERSION=""

# ISO timestamps written only after the named real-world check is completed.
# They expire in the release gate and cannot be replaced by automated unit tests.
LEGAL_REVIEW_ATTESTED_AT=""
AI_EVAL_ATTESTED_AT=""
PAYMENT_E2E_ATTESTED_AT=""
RESTORE_DRILL_ATTESTED_AT=""
INCIDENT_DRILL_ATTESTED_AT=""
SECURITY_REVIEW_ATTESTED_AT=""
CRISIS_RESOURCES_VERIFIED_AT=""
CHILD_SAFETY_REVIEWED_AT=""
CHILD_PRIVACY_REVIEWED_AT=""
ACCESS_REVIEW_ATTESTED_AT=""

# AI coach (multi-turn, tool-calling) rate limits
COACH_RATE_LIMIT=20
COACH_RATE_WINDOW_MS=60000

# Nightly job: users processed concurrently per batch
NIGHTLY_CONCURRENCY=8

# Memory layer embeddings (falls back to a deterministic local hash without a key)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Weekly growth-card job
WEEKLY_CONCURRENCY=8
# Secret for POST/GET /api/cron/weekly (also accepts "Authorization: Bearer <secret>").
# Set this and trigger the URL from any cron / scheduled task to push weekly cards.
CRON_SECRET=""
