# ===== Neon Postgres (Vercel → Project → Settings → Environment Variables) =====
# Pooled connection (runtime, serverless-friendly). Neon "Pooled connection" string.
DATABASE_URL="postgresql://<user>:<pwd>@<ep>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (migrations / db push). Neon "Direct connection" string.
DIRECT_URL="postgresql://<user>:<pwd>@<ep>.<region>.aws.neon.tech/<db>?sslmode=require"

# ===== Auth & app =====
AUTH_SECRET="<long-random-string>"   # HMAC session signing
AUTH_REQUIRED="true"                  # force login in prod
# DEV_USER_ID=                        # leave UNSET in prod

# ===== AI provider (mock runs fully offline; set real keys to go live) =====
AI_PROVIDER="mock"                    # mock | openai | anthropic
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# ===== Optional Neo4j knowledge graph (inert unless set) =====
NEO4J_HTTP_URL=""
NEO4J_USER=""
NEO4J_PASSWORD=""

# ===== Admin panel (/admin) — comma-separated emails allowed into the admin =====
ADMIN_EMAILS="you@example.com"

# Absolute site URL (for SEO / OpenGraph metadata)
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
